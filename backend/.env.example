APP_ENV=development
DEVELOPMENT_MODE=true

PORT=3000

# Comma-separated allowed origins for CORS. Only read when
# DEVELOPMENT_MODE isn't 'true' (dev mode allows any origin).
FRONTEND_ORIGIN=

# MongoDB Atlas connection string (Data Explorer -> Connect -> Drivers).
# Use a database name unique to this project on the cluster.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.rllp3bl.mongodb.net/solmarket?appName=Cluster0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# A separate secret from JWT_SECRET, used only for admin sessions.
ADMIN_JWT_SECRET=
